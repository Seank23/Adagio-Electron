{
  "name": "adagio",
  "version": "0.1.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "cd ui && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:ui": "cd ui && npm run build",
    "build": "npm run build:ui && electron-builder",
    "start": "electron .",
    "test": "cd ui && npm test",
    "test:e2e": "playwright test -c e2e/playwright.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "wait-on": "^9.0.3"
  },
  "allowScripts": {
    "electron@39.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
