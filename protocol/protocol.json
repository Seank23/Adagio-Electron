{
    "version": 2,
    "transport": {
        "host": "127.0.0.1",
        "port": 9001,
        "tokenParam": "token",
        "allowedOrigins": ["file://", "http://localhost:5173", "http://127.0.0.1:5173"]
    },
    "envelope": {
        "comment": "Renderer -> engine: {id, cmd, args}. Engine -> renderer: {type: 'reply', id, ok, value, error} for a command, {type, value} for an event.",
        "replyType": "reply"
    },
    "commands": [
        { "name": "load", "cpp": "Load", "js": "LOAD", "arg": "string" },
        { "name": "play", "cpp": "Play", "js": "PLAY", "arg": "none" },
        { "name": "pause", "cpp": "Pause", "js": "PAUSE", "arg": "none" },
        { "name": "stop", "cpp": "Stop", "js": "STOP", "arg": "none" },
        { "name": "clear", "cpp": "Clear", "js": "CLEAR", "arg": "none" },
        { "name": "seek", "cpp": "Seek", "js": "SEEK", "arg": "number" },
        { "name": "stepFrame", "cpp": "StepFrame", "js": "STEP_FRAME", "arg": "none" },
        { "name": "resetAnalysis", "cpp": "ResetAnalysis", "js": "RESET_ANALYSIS", "arg": "none" },
        { "name": "setVolume", "cpp": "SetVolume", "js": "SET_VOLUME", "arg": "number" },
        { "name": "setSpeed", "cpp": "SetSpeed", "js": "SET_SPEED", "arg": "number" },
        { "name": "analyseFrame", "cpp": "AnalyseFrame", "js": "ANALYSE_FRAME", "arg": "none" },
        { "name": "getAnalysisSchema", "cpp": "GetAnalysisSchema", "js": "GET_ANALYSIS_SCHEMA", "arg": "none" },
        { "name": "setAnalysisSetting", "cpp": "SetAnalysisSetting", "js": "SET_ANALYSIS_SETTING", "arg": "object" },
        { "name": "setEngineParams", "cpp": "SetEngineParams", "js": "SET_ENGINE_PARAMS", "arg": "object" },
        { "name": "status", "cpp": "Status", "js": "STATUS", "arg": "none" },
        { "name": "getWaveform", "cpp": "GetWaveform", "js": "GET_WAVEFORM", "arg": "none" },
        { "name": "shutdown", "cpp": "Shutdown", "js": "SHUTDOWN", "arg": "none" }
    ],
    "events": [
        { "name": "transport", "cpp": "Transport", "js": "TRANSPORT" },
        { "name": "position", "cpp": "Position", "js": "POSITION" },
        { "name": "fileLoaded", "cpp": "FileLoaded", "js": "FILE_LOADED" },
        { "name": "fileClosed", "cpp": "FileClosed", "js": "FILE_CLOSED" },
        { "name": "endOfPlay", "cpp": "EndOfPlay", "js": "END_OF_PLAY" },
        { "name": "analysis", "cpp": "Analysis", "js": "ANALYSIS" },
        { "name": "analysisReset", "cpp": "AnalysisReset", "js": "ANALYSIS_RESET" },
        { "name": "info", "cpp": "Info", "js": "INFO" },
        { "name": "error", "cpp": "Error", "js": "ERROR" },
        { "name": "reply", "cpp": "Reply", "js": "REPLY" }
    ],
    "states": [
        { "name": "empty", "cpp": "Empty", "js": "EMPTY" },
        { "name": "loading", "cpp": "Loading", "js": "LOADING" },
        { "name": "ready", "cpp": "Ready", "js": "READY" },
        { "name": "playing", "cpp": "Playing", "js": "PLAYING" },
        { "name": "paused", "cpp": "Paused", "js": "PAUSED" }
    ],
    "binaryFrames": {
        "comment": "High-rate data travels as binary WebSocket messages: a fixed little-endian header, then count elements. Every field is naturally aligned, so the data can be viewed in place at headerSize. resolution is binHz for a spectrum and frames per peak for a waveform. A spectrum is Uint16 of magnitude / maxMagnitude.",
        "headerSize": 32,
        "kinds": [
            { "name": "spectrum", "cpp": "Spectrum", "js": "SPECTRUM", "value": 1 },
            { "name": "waveform", "cpp": "Waveform", "js": "WAVEFORM", "value": 2 }
        ],
        "elementTypes": [
            { "name": "float32", "cpp": "Float32", "js": "FLOAT32", "value": 1 },
            { "name": "uint16", "cpp": "Uint16", "js": "UINT16", "value": 2 }
        ],
        "header": [
            { "name": "kind", "cpp": "Kind", "type": "u8", "byteOffset": 0 },
            { "name": "version", "cpp": "Version", "type": "u8", "byteOffset": 1 },
            { "name": "elementType", "cpp": "ElementType", "type": "u16", "byteOffset": 2 },
            { "name": "seekGeneration", "cpp": "SeekGeneration", "type": "u32", "byteOffset": 4 },
            { "name": "timestamp", "cpp": "Timestamp", "type": "f64", "byteOffset": 8 },
            { "name": "resolution", "cpp": "Resolution", "type": "f32", "byteOffset": 16 },
            { "name": "maxMagnitude", "cpp": "MaxMagnitude", "type": "f32", "byteOffset": 20 },
            { "name": "count", "cpp": "Count", "type": "u32", "byteOffset": 24 },
            { "name": "reserved", "cpp": "Reserved", "type": "u32", "byteOffset": 28 }
        ]
    },
    "limits": {
        "comment": "Volume and speed travel as normalised floats, not percentages. The sliders are the only place percentages exist. The analysis sample rate, frame length and hop size are each one of their list.",
        "volumeMin": 0.0,
        "volumeMax": 1.0,
        "speedMin": 0.2,
        "speedMax": 1.0,
        "sampleRates": [4000, 8000, 16000],
        "sampleRateDefault": 8000,
        "frameLengths": [2048, 4096, 8192],
        "frameLengthDefault": 4096,
        "hopSizes": [32, 64, 128, 256],
        "hopSizeDefault": 128
    }
}
